# Copy to .env.local. With nothing filled in, the app runs in DEMO mode: no SMS is sent.
# Placeholders only. Never commit real values.

# Required for a public deployment: a long random string (32+ chars), e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the app (leave empty for http://localhost:3000)
BETTER_AUTH_URL=

# Database: empty = local SQLite file ./data/app.db. For Vercel use Postgres (e.g. Neon): postgres://user:pass@host/db
DATABASE_URL=

# kwtSMS API credentials (kwtsms.com > Account > API). Fill in to leave demo mode (test mode: test=1, nothing delivered).
KWTSMS_USERNAME=
KWTSMS_PASSWORD=
# Sender ID: KWT-SMS is for testing only. Live needs your own approved Sender ID (approval takes time).
KWTSMS_SENDER_ID=KWT-SMS
# Set to 1 to send real SMS and spend credits. Anything else = test=1.
KWTSMS_LIVE=

# Destination country codes allowed, comma separated. Empty denies everything. Default 965 (Kuwait).
KWTSMS_ALLOWED_COUNTRIES=965
# Header your platform sets with the real client IP (Vercel: x-vercel-forwarded-for). Never a header a client can set.
KWTSMS_IP_HEADER=x-vercel-forwarded-for
# Shown in the SMS text, max 16 ASCII characters
APP_NAME=kwtSMS Demo

# Abuse limits (defaults shown). OTP_MAX_GLOBAL_DAY=0 blocks all sends (kill switch).
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_HOUR=3
OTP_MAX_PER_PHONE_DAY=5
OTP_MAX_GLOBAL_DAY=200
OTP_MAX_PER_IP_HOUR=10
OTP_MAX_VERIFY_PER_IP_10MIN=30

# Only for `npm run smoke` (manual test=1 send). Your own test number, 965XXXXXXXX format.
KWTSMS_TEST_NUMBER=965XXXXXXXX
